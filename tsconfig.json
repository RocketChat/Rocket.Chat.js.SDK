{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"strict": true,
		"types": ["node"],
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": false,
		"forceConsistentCasingInFileNames": true
	},
	// Specs and test helpers are checked by tsconfig.test.json instead. Keeping
	// them out of this program keeps jest's globals out of it too, so a stray
	// `describe` in shipped source fails `npm run typecheck` here rather than in
	// the consuming app.
	"exclude": ["node_modules", "test", "**/*.spec.ts"]
}
