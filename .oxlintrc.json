	// sites below are cleared.
	//
	//   no-unused-expressions          7  lib/api/api.ts, lib/drivers/ddp.ts
	//   no-this-alias                  3  lib/api/RocketChat.ts, lib/util.ts
	//   no-async-promise-executor      2  lib/drivers/ddp.ts
	//   triple-slash-reference         1  lib/drivers/ddp.ts
	//   no-unsafe-declaration-merging  1  lib/message.ts
	//   no-unused-vars                 3  lib/clients/Livechat.ts
	//
	// The three no-unused-vars sites are destructured constructor parameters that
	// exist to strip keys out of `...config`. The `_` convention does not apply:
	// renaming one changes which property is stripped.
	//
	// Total: 17 warnings.
	"rules": {
		"no-unused-expressions": "warn",
		"no-this-alias": "warn",
		"no-async-promise-executor": "warn",
		"triple-slash-reference": "warn",
		"no-unsafe-declaration-merging": "warn",
		"no-unused-vars": "warn"
	}
}
